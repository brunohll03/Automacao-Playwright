
# Arquivo que indica ao Git quais arquivos ou pastas não devem ser versionados.
# Evita que arquivos temporários, ambientes virtuais ou dados sensíveis
# sejam enviados ao repositório.

venv/  
allure-results/
__pycache__/
.pytest_cache/

# Ignora todos os screenshots gerados durante os testes
utils/screenshots/*

# Mantém a pasta no repositório mesmo vazia
!utils/screenshots/.gitkeep
